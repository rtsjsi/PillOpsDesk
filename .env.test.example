# Copy to .env.test and fill in your credentials (do not commit .env.test)

# Required — login credentials for E2E
E2E_USERNAME=owner
E2E_PIN=your-pin-here

# Recommended — point at your real app profile (already licensed + users)
# Windows default dev profile:
# E2E_USER_DATA=C:\Users\YOUR_NAME\AppData\Roaming\pillopsdesk

# Only needed when using an empty isolated profile (tests/e2e/.user-data)
# E2E_LICENSE_KEY=
